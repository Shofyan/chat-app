{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ruang Chat - Chrome",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port",
        "3000",
        "--dart-define=API_BASE_URL=http://localhost:8080"
      ]
    },
    {
      "name": "Ruang Chat - Mobile",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/mobile",
      "program": "${workspaceFolder}/mobile/lib/main.dart"
    }
  ]
}
